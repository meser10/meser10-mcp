<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:tns="http://messagingsystem.co.il/" xmlns:s="http://www.w3.org/2001/XMLSchema"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  targetNamespace="http://messagingsystem.co.il/">
  <wsdl:types>
    <s:schema targetNamespace="http://messagingsystem.co.il/">
      <s:element name="GetGroupsList">
        <s:complexType><s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="oLogin" type="tns:CLoginInfo"/>
          <s:element minOccurs="1" maxOccurs="1" name="iUserID" type="s:int"/>
        </s:sequence></s:complexType>
      </s:element>
      <s:element name="GetGroupsListResponse">
        <s:complexType><s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="GetGroupsListResult" type="tns:ArrayOfCGroup"/>
        </s:sequence></s:complexType>
      </s:element>
      <s:element name="SendSingleSmsMessage">
        <s:complexType><s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="oLogin" type="tns:CLoginInfo"/>
          <s:element minOccurs="1" maxOccurs="1" name="iUserID" type="s:int"/>
          <s:element minOccurs="0" maxOccurs="1" name="sPhoneNumber" type="s:string"/>
          <s:element minOccurs="0" maxOccurs="1" name="sMessageText" type="s:string"/>
          <s:element minOccurs="1" maxOccurs="1" name="eLang" type="tns:ELang"/>
        </s:sequence></s:complexType>
      </s:element>
      <s:element name="SendSingleSmsMessageResponse">
        <s:complexType><s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="SendSingleSmsMessageResult" type="tns:CCallResult"/>
        </s:sequence></s:complexType>
      </s:element>
      <s:element name="DeleteGroup">
        <s:complexType><s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="oLogin" type="tns:CLoginInfo"/>
          <s:element minOccurs="1" maxOccurs="1" name="iGroupID" type="s:int"/>
        </s:sequence></s:complexType>
      </s:element>
      <s:element name="DeleteGroupResponse">
        <s:complexType><s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="DeleteGroupResult" type="tns:CCallResult"/>
        </s:sequence></s:complexType>
      </s:element>
      <s:element name="ChangeContactStatus"><s:complexType><s:sequence>
        <s:element minOccurs="0" maxOccurs="1" name="oLogin" type="tns:CLoginInfo"/>
      </s:sequence></s:complexType></s:element>
      <s:element name="ChangeContactStatusResponse"><s:complexType><s:sequence>
        <s:element minOccurs="0" maxOccurs="1" name="ChangeContactStatusResult" type="tns:CCallResult"/>
      </s:sequence></s:complexType></s:element>
      <s:element name="ChangeContactStatusEx"><s:complexType><s:sequence>
        <s:element minOccurs="0" maxOccurs="1" name="oLogin" type="tns:CLoginInfo"/>
        <s:element minOccurs="1" maxOccurs="1" name="eStatus" type="tns:EContactStatus"/>
      </s:sequence></s:complexType></s:element>
      <s:element name="ChangeContactStatusExResponse"><s:complexType><s:sequence>
        <s:element minOccurs="0" maxOccurs="1" name="ChangeContactStatusExResult" type="tns:CCallResult"/>
      </s:sequence></s:complexType></s:element>
      <s:complexType name="CLoginInfo"><s:sequence>
        <s:element minOccurs="0" maxOccurs="1" name="UserName" type="s:string"/>
        <s:element minOccurs="0" maxOccurs="1" name="Password" type="s:string"/>
        <s:element minOccurs="0" maxOccurs="1" name="ApiKey" type="s:string"/>
      </s:sequence></s:complexType>
      <s:complexType name="CCallResult"><s:sequence>
        <s:element minOccurs="1" maxOccurs="1" name="Result" type="tns:EWSCallResultType"/>
        <s:element minOccurs="0" maxOccurs="1" name="Description" type="s:string"/>
      </s:sequence></s:complexType>
      <s:complexType name="CGroup"><s:sequence>
        <s:element minOccurs="1" maxOccurs="1" name="ID" type="s:int"/>
        <s:element minOccurs="0" maxOccurs="1" name="Name" type="s:string"/>
      </s:sequence></s:complexType>
      <s:complexType name="ArrayOfCGroup"><s:sequence>
        <s:element minOccurs="0" maxOccurs="unbounded" name="CGroup" type="tns:CGroup"/>
      </s:sequence></s:complexType>
      <s:simpleType name="EWSCallResultType"><s:restriction base="s:string">
        <s:enumeration value="Success"/><s:enumeration value="LoginFailed"/>
        <s:enumeration value="InvalidParameters"/><s:enumeration value="PartialSuccess"/>
      </s:restriction></s:simpleType>
      <s:simpleType name="ELang"><s:restriction base="s:string">
        <s:enumeration value="Default"/><s:enumeration value="Hebrew"/><s:enumeration value="English"/>
      </s:restriction></s:simpleType>
      <s:simpleType name="EContactStatus"><s:restriction base="s:string">
        <s:enumeration value="Active"/><s:enumeration value="Removed"/>
      </s:restriction></s:simpleType>
    </s:schema>
  </wsdl:types>
  <wsdl:portType name="ServicesSoap">
    <wsdl:operation name="GetGroupsList"/>
    <wsdl:operation name="SendSingleSmsMessage"/>
    <wsdl:operation name="DeleteGroup"/>
    <wsdl:operation name="ChangeContactStatus"/>
    <wsdl:operation name="ChangeContactStatusEx"/>
  </wsdl:portType>
  <wsdl:binding name="ServicesSoap" type="tns:ServicesSoap">
    <wsdl:operation name="GetGroupsList"><soap:operation soapAction="http://messagingsystem.co.il/GetGroupsList" style="document"/></wsdl:operation>
    <wsdl:operation name="SendSingleSmsMessage"><soap:operation soapAction="http://messagingsystem.co.il/SendSingleSmsMessage" style="document"/></wsdl:operation>
    <wsdl:operation name="DeleteGroup"><soap:operation soapAction="http://messagingsystem.co.il/DeleteGroup" style="document"/></wsdl:operation>
    <wsdl:operation name="ChangeContactStatus"><soap:operation soapAction="http://messagingsystem.co.il/ChangeContactStatus" style="document"/></wsdl:operation>
    <wsdl:operation name="ChangeContactStatusEx"><soap:operation soapAction="http://messagingsystem.co.il/ChangeContactStatusEx" style="document"/></wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="Services">
    <wsdl:port name="ServicesSoap" binding="tns:ServicesSoap">
      <soap:address location="https://ns.mesereser.com/Services/Services.asmx"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
