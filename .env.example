# Meser10 MCP server configuration.
# NEVER commit a real .env. The server reads credentials from the environment only.

# Required. Issued in the Meser10 UI. The server authenticates with ApiKey and
# never accepts or transmits an account password.
MESER10_API_KEY=

# Required for the 44 operations that take an explicit account id.
MESER10_USER_ID=

# Optional. Defaults to the production endpoint.
MESER10_ENDPOINT=https://ns.mesereser.com/Services/Services.asmx

# Safety gate. One of: read | write | send | destructive
# read        (default) only the 16 Get* operations are exposed
# write       adds contact/group/campaign creation and edits
# send        adds the 13 operations that deliver messages to real recipients
# destructive adds the 5 delete/remove operations
MESER10_MODE=read

# Optional hard cap on recipients for any single send call. Ignored in read mode.
MESER10_MAX_RECIPIENTS=100
